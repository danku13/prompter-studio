# Скопируйте в .env и настройте под себя
# SQLite-база (файл появится в db/)
DATABASE_URL=file:./db/custom.db

# Режим WebSocket-клиента: direct (LAN) | gateway (песочница с прокси)
WS_MODE=direct

# Внутренний адрес WS-мини-сервиса (запускается на этом же компьютере)
MINI_SERVICE_URL=http://127.0.0.1:3030

# Время жизни pairing-токена, минут
PAIR_TTL_MIN=15
