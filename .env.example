# Скопируйте в .env и настройте под себя
# SQLite-база (файл появится в db/)
DATABASE_URL=file:./db/custom.db

# Режим WebSocket-клиента: direct (LAN) | gateway (песочница с прокси)
WS_MODE=direct

# Внутренний адрес WS-мини-сервиса (запускается на этом же компьютере)
MINI_SERVICE_URL=http://127.0.0.1:3030

# Время жизни pairing-токена, минут
PAIR_TTL_MIN=15

# ============================================================================
# НИЖЕ — ЗАГОТОВКИ для будущих этапов (планы docs/plan/02-auth.md и
# docs/plan/04-payments.md). Пока НЕ обязательны: раскомментируйте
# при внедрении соответствующего этапа. Секреты генерируйте сами
# (openssl rand -base64 32) и НИКОГДА не коммитьте реальные значения.
# ============================================================================

# --- Авторизация (M2: Яндекс ID / Google ID, NextAuth) ---
# NEXTAUTH_URL=https://app.example.ru        # базовый URL для OAuth-редиректов
# NEXTAUTH_SECRET=                           # openssl rand -base64 32 (обязателен при включении NextAuth)
# APP_SECRET=                                # ключ шифрования OAuth-токенов at rest (AES-256-GCM), хранить вне БД
# YANDEX_CLIENT_ID=                          # из консоли Яндекс OAuth (oauth.yandex.ru/client/new)
# YANDEX_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=                          # из Google Cloud Console → Credentials
# GOOGLE_CLIENT_SECRET=

# --- Платежи (M3: ЮKassa / Prodamus) ---
# YOOKASSA_SHOP_ID=                          # id магазина ЮKassa
# YOOKASSA_SECRET_KEY=                       # секретный ключ (Basic auth API v3)
# YOOKASSA_RETURN_URL=                       # https://<домен>/billing/return — только наш домен
# PRODAMUS_PAYMENT_URL=                      # https://<subdomain>.payform.ru/
# PRODAMUS_SECRET_KEY=                       # секретный ключ платёжной страницы (подпись запросов)
# PRODAMUS_WEBHOOK_SECRET=                   # ключ проверки Sign входящих вебхуков (если отличается)
# PRODAMUS_SYS=                              # идентификатор интеграции (выдаёт поддержка Prodamus)
# PRODAMUS_BINDING_SECRET_KEY=               # отдельный ключ «оплаты по связке» (если используется сценарий)
# PAYMENTS_CRON_ENABLED=true                 # планировщик рекуррентных списаний (ЮKassa, merchant-managed)


# --- PIN-доступ (P0; работает и без этой переменной) ---
# AUTH_SECRET=                               # опционально: HMAC-ключ тикетов доступа; по умолчанию
#                                            # создаётся файл mini-services/prompter-sync/runtime-auth-secret
