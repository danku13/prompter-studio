DATABASE_URL=file:/home/z/my-project/db/custom.db

# Prompter Studio (значения по умолчанию; можно переопределить)
# Режим WS: direct — телефон подключается напрямую ws://<host>:3030 (LAN-деплой)
WS_MODE=direct
# Адрес WS-мини-сервиса для внутреннего оповещения о сохранении сценария
MINI_SERVICE_URL=http://127.0.0.1:3030
# Время жизни pairing-токена, минут
PAIR_TTL_MIN=15
